rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isGameMaster() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/gameMasters/$(request.auth.uid));
    }

    match /games/{gameId} {
      allow read: if true;
      allow create: if isGameMaster();
      allow update, delete: if isGameMaster();
    }

    match /games/{gameId}/gameRosters/{entryId} {
      allow read: if true;
      allow create: if true;
    }

    match /gameMasters/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /gameMasterInvites/{token} {
      allow create: if isGameMaster();
      allow read, update: if isSignedIn();
    }

    match /playerProfiles/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read: if true;
    }
  }
}
